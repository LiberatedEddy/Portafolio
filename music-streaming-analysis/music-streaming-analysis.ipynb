# ------------------------------------------
# Paso 1 — Importar librerías
# ------------------------------------------

import pandas as pd

# ------------------------------------------
# Paso 2 — Cargar dataset
# ------------------------------------------

df = pd.read_csv('music-streaming-analysis/datasets/music_project_en.csv')

# ------------------------------------------
# Paso 3 — Exploración inicial
# ------------------------------------------

print(df.head())
print(df.info())
print(df.describe())

# ------------------------------------------
# Paso 4 — Limpieza de nombres de columnas
# ------------------------------------------

df.columns = df.columns.str.lower().str.replace(' ', '_')

print(df.columns)

# ------------------------------------------
# Paso 5 — Revisar valores ausentes
# ------------------------------------------

print(df.isna().sum())

# ------------------------------------------
# Paso 6 — Reemplazar valores ausentes
# ------------------------------------------

columns_to_replace = ['track', 'artist', 'genre']

for column in columns_to_replace:
    df[column] = df[column].fillna('unknown')

# ------------------------------------------
# Paso 7 — Revisar duplicados
# ------------------------------------------

print(df.duplicated().sum())

# Eliminar duplicados
df = df.drop_duplicates()

# ------------------------------------------
# Paso 8 — Revisar géneros únicos
# ------------------------------------------

print(sorted(df['genre'].unique()))

# ------------------------------------------
# Paso 9 — Corregir duplicados implícitos
# ------------------------------------------

def replace_wrong_genres(wrong_genres, correct_genre):

    for wrong_genre in wrong_genres:
        df['genre'] = df['genre'].replace(
            wrong_genre,
            correct_genre
        )

replace_wrong_genres(
    ['hip', 'hop', 'hip-hop'],
    'hiphop'
)

# ------------------------------------------
# Paso 10 — Función para contar canciones
# ------------------------------------------

def number_tracks(day, city):

    track_list = df[
        (df['day'] == day) &
        (df['city'] == city)
    ]

    track_count = track_list['user_id'].count()

    return track_count

# ------------------------------------------
# Paso 11 — Pruebas de la función
# ------------------------------------------

print(number_tracks('Monday', 'Springfield'))
print(number_tracks('Friday', 'Shelbyville'))

# ------------------------------------------
# Paso 12 — Géneros más escuchados
# ------------------------------------------

def genre_weekday(df, day, city):

    genre_df = df[
        (df['day'] == day) &
        (df['city'] == city)
    ]

    genre_df = (
        genre_df.groupby('genre')['genre']
        .count()
        .sort_values(ascending=False)
    )

    return genre_df[:15]

# ------------------------------------------
# Paso 13 — Top géneros por ciudad
# ------------------------------------------

print(
    genre_weekday(df, 'Monday', 'Springfield')
)

print(
    genre_weekday(df, 'Friday', 'Shelbyville')
)

# ------------------------------------------
# Paso 14 — Resumen final
# ------------------------------------------

print('\n===== RESUMEN DEL ANÁLISIS =====\n')

print('Dataset limpiado correctamente.')
print('Valores ausentes tratados.')
print('Duplicados eliminados.')
print('Géneros estandarizados.')
print('Análisis exploratorio completado.')

